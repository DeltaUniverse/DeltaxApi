{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deltaxapi",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "api.deltax.bond",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
